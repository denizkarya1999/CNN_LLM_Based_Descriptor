  "metric_definitions": {
    "TP": "valid action on positive reference",
    "TN": "valid no-action on negative reference",
    "FP": "valid action on negative reference",
    "FN": "valid no-action on positive reference",
    "AP": "unavailable output on positive reference",
    "AN": "unavailable output on negative reference",
    "accuracy": "(TP+TN)/N",
    "precision": "TP/(TP+FP)",
    "recall": "TP/(TP+FN+AP)",
    "specificity": "TN/(TN+FP+AN)",
    "f1": "2TP/(2TP+FP+FN+AP)",
    "negative_f1": "2TN/(2TN+FN+FP+AN)",
    "macro_f1": "(f1+negative_f1)/2",
    "balanced_accuracy": "(recall+specificity)/2",
    "decision_coverage": "(N-AP-AN)/N"
  },
